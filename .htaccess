# Block the secret env file
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
# Hide operator page from search engines
<Files "update.html">
    Header always set X-Robots-Tag "noindex, nofollow"
</Files>
# Short cache for HTML so updates appear fast; long cache for hashed assets
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
# Block the .git directory from the web
RedirectMatch 404 /\.git
# Team panel (proxied to the codoo-bot Worker; Basic Auth enforced by the Worker).
# app.php is a universal proxy — it forwards the path, the query and the auth
# header verbatim — so a new panel page needs nothing here except its name in
# this list. Keep it in step with the sidebar in the Worker's nav.ts.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(admin|panel|inbox|arrivals|apartments|learn|waiting|ask|health|progress|incidents|status|img)(/.*)?$ app.php [L,QSA]
</IfModule>
